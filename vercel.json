{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/index.php", "dest": "/api/index.php" },
    { "src": "/karya.php", "dest": "/api/karya.php" },
    { "src": "/kelas.php", "dest": "/api/kelas.php" },
    { "src": "/materi.php", "dest": "/api/materi.php" },
    { "src": "/video.php", "dest": "/api/video.php" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}